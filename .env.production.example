# Production Environment Configuration
# Copy this to .env.production and update with your production values

# Database Configuration - USE STRONG CREDENTIALS IN PRODUCTION!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pos_restaurant
POSTGRES_USER=postgres_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Application Configuration
NODE_ENV=production
PORT=3000
APP_PORT=3000

# JWT Secret - MUST BE CHANGED!
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Logging
LOG_LEVEL=info

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=https://yourdomain.com

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
